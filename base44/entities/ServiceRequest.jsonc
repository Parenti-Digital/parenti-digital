{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "organization": {
      "type": "string",
      "title": "Organization"
    },
    "service": {
      "type": "string",
      "title": "Service requested"
    },
    "budget": {
      "type": "string",
      "title": "Budget range"
    },
    "timeline": {
      "type": "string",
      "title": "Timeline"
    },
    "message": {
      "type": "string",
      "title": "Details"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "contacted",
        "quoted",
        "won",
        "lost"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "green",
        "gray"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}