{
  "description": "Emails the owner when a new ServiceRequest is submitted through the contact form.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ServiceRequest"
    }
  },
  "name": "New Service Request Notification",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_service_request_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_owner": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/notify-service-request",
            "body": {
              "name": "${ .trigger.data.name }",
              "email": "${ .trigger.data.email }",
              "phone": "${ .trigger.data.phone }",
              "organization": "${ .trigger.data.organization }",
              "service": "${ .trigger.data.service }",
              "message": "${ .trigger.data.message }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify owner",
            "description": "Emails the new request details"
          }
        }
      }
    ]
  }
}